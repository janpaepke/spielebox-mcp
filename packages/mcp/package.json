    "pack:mcpb": "pnpm build && node scripts/pack-mcpb.ts"
  },
  "dependencies": {
    "@janpaepke/spielebox-client": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
