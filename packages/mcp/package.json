{
  "name": "spielebox-mcp",
  "version": "0.6.2",
  "description": "Unofficial MCP server for the WIENXTRA-Spielebox online catalog; not affiliated with WIENXTRA",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Jan Paepke (https://github.com/janpaepke)",
  "homepage": "https://github.com/janpaepke/spielebox-mcp#readme",
  "bugs": "https://github.com/janpaepke/spielebox-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpaepke/spielebox-mcp.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "claude",
    "wienxtra",
    "spielebox",
    "board games"
  ],
  "bin": {
    "spielebox-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.mjs",
    "pack:mcpb": "pnpm build && node scripts/pack-mcpb.ts"
  },
  "dependencies": {
    "@janpaepke/spielebox-client": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
