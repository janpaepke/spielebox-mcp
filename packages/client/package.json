{
  "name": "@janpaepke/spielebox-client",
  "version": "0.0.0",
  "description": "Typed client for the WIENXTRA-Spielebox online catalog (opac.wienxtra.at)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
