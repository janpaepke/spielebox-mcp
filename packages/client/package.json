{
  "name": "@janpaepke/spielebox-client",
  "version": "0.6.2",
  "description": "Unofficial typed client for the WIENXTRA-Spielebox online catalog (opac.wienxtra.at); not affiliated with WIENXTRA",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Jan Paepke (https://github.com/janpaepke)",
  "homepage": "https://github.com/janpaepke/spielebox-mcp#readme",
  "bugs": "https://github.com/janpaepke/spielebox-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpaepke/spielebox-mcp.git",
    "directory": "packages/client"
  },
  "keywords": [
    "wienxtra",
    "spielebox",
    "board games",
    "library",
    "opac",
    "vienna"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures": "node scripts/refresh-fixtures.ts",
    "test:live": "SPIELEBOX_LIVE=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "lru-cache": "^11.5.3",
    "p-queue": "^9.3.3",
    "zod": "^4.6.5"
  }
}
